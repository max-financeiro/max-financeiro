# ============================================================
# Sistema Financeiro Maxfem - exemplo de variáveis de ambiente
# ============================================================
# Nunca commitar .env real. Segredos vivem no Supabase Vault.
# Aqui só ficam placeholders + endpoints públicos.

# --- Ambiente ---
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=https://app.financeiromaxfem.com.br
NEXT_PUBLIC_PORTAL_URL=https://portal.financeiromaxfem.com.br

# --- Supabase (URL + ANON são públicos; service role NUNCA exposto ao client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role apenas para CI/migrations - rotacionar a cada 90 dias
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Sentry (opcional em dev, obrigatório em prod) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Resend (email transacional) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=financeiro@financeiromaxfem.com.br
# Caixa interna que recebe avisos administrativos (mudança de dados
# bancários do fornecedor, alertas anti-fraude etc). Default: cai pro
# RESEND_FROM_EMAIL se não definida.
FINANCEIRO_NOTIFY_EMAIL=

# --- Criptografia (pgcrypto) ---
# Chave AES usada pra decriptar/encriptar dados bancários, credenciais
# Inter, tokens Bling/Focus etc. Gere com `openssl rand -hex 32` e
# guarde no Vault. SEM ELA, nada que dependa de RPC criptografada funciona.
BANK_ENCRYPTION_KEY=

# Payment provider ativo: 'mock' (dev/staging) ou 'inter' (prod).
# Em 'inter', a credencial é lida da tabela inter_credentials (cadastrada
# em /integracoes/inter) e BANK_ENCRYPTION_KEY é obrigatória.
PAYMENT_PROVIDER=mock

# --- Integrações ---
# Banco Inter (mTLS): a credencial — client_id/secret, certificado, chave e
# segredo do webhook — é cadastrada pela UI em /integracoes/inter e fica
# ENCRYPTED no banco (pgcrypto). NÃO precisa de variável de ambiente aqui.
# Para o sistema usar o Inter em vez do mock, defina PAYMENT_PROVIDER=inter
# (ver abaixo) e BANK_ENCRYPTION_KEY.
#
# Opcional — IP allowlist do webhook do Inter (CIDR/IP separados por vírgula).
# Vazio = allowlist desativada.
INTER_WEBHOOK_IPS=

# BTG Empresas (DDA)
BTG_CLIENT_ID=
BTG_CLIENT_SECRET=
BTG_WEBHOOK_SECRET=

# Bling V3
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Anthropic (V1 - IA de conciliação)
ANTHROPIC_API_KEY=

# BrasilAPI - sem auth
# (URL fixa: https://brasilapi.com.br)

# --- Webhooks ---
# O path secreto do webhook Inter é gerado automaticamente ao conectar a
# integração e fica salvo no banco (inter_credentials.webhook_secret_path).
BTG_WEBHOOK_PATH=

# --- Limites de segurança (overrideable mas com defaults seguros) ---
DAILY_AGGREGATE_LIMIT_BRL=100000
MAX_PAYMENT_AMOUNT_BRL=1000000
SESSION_TIMEOUT_ADMIN_MINUTES=480
SESSION_TIMEOUT_SUPPLIER_MINUTES=60

# --- Sprint 4b: Portal NF-e + Antivírus ---
# Antivírus (Cloudmersive opcional - free tier 800 calls/mês)
ENABLE_ANTIVIRUS=false
CLOUDMERSIVE_API_KEY=

# Rate limits (configurável por env)
RATE_LIMIT_MAGIC_LINK_PER_HOUR=5
RATE_LIMIT_NF_UPLOAD_PER_HOUR=50

# --- Sprint 7-A: Bling leitura ---
# 'mock' (default sem credencial) ou 'real' (OAuth conectado + BANK_ENCRYPTION_KEY)
BLING_PROVIDER=mock
# Em mock, força um org_id pra rodar sync mesmo sem bling_credentials (staging)
BLING_MOCK_ORG_ID=
# Vercel injeta automaticamente quando configurado. Local: gere com `openssl rand -hex 32`.
CRON_SECRET=
