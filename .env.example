# ============================================================
# Sistema Financeiro Maxfem - exemplo de variáveis de ambiente
# ============================================================
# Nunca commitar .env real. Segredos vivem no Supabase Vault.
# Aqui só ficam placeholders + endpoints públicos.

# --- Ambiente ---
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=https://app.financeiromaxfem.com.br
NEXT_PUBLIC_PORTAL_URL=https://portal.financeiromaxfem.com.br

# --- Supabase (URL + ANON são públicos; service role NUNCA exposto ao client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role apenas para CI/migrations - rotacionar a cada 90 dias
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Sentry (opcional em dev, obrigatório em prod) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Resend (email transacional) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=financeiro@financeiromaxfem.com.br

# --- Integrações (todas as keys vivem no Supabase Vault em prod, aqui só pra dev local) ---
# Banco Inter (mTLS) - certs vão para o Vault, NUNCA no .env
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_WEBHOOK_SECRET=

# BTG Empresas (DDA)
BTG_CLIENT_ID=
BTG_CLIENT_SECRET=
BTG_WEBHOOK_SECRET=

# Bling V3
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Anthropic (V1 - IA de conciliação)
ANTHROPIC_API_KEY=

# BrasilAPI - sem auth
# (URL fixa: https://brasilapi.com.br)

# --- Webhooks (paths únicos não-adivinháveis, gerados na hora do setup) ---
INTER_WEBHOOK_PATH=
BTG_WEBHOOK_PATH=

# --- Limites de segurança (overrideable mas com defaults seguros) ---
DAILY_AGGREGATE_LIMIT_BRL=100000
MAX_PAYMENT_AMOUNT_BRL=1000000
SESSION_TIMEOUT_ADMIN_MINUTES=480
SESSION_TIMEOUT_SUPPLIER_MINUTES=60
