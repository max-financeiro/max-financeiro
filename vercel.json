{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "next build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/bling/sync",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/focus/sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/inter-conciliacao",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/bling-receivables",
      "schedule": "45 11 * * *"
    }
  ]
}
