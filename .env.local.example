# ============================================================
# .env.local — ambiente DEV
# ============================================================
# Copie este arquivo pra `.env.local` (já está gitignored) e preencha os campos.
# Service role NUNCA commitado em lugar nenhum — só aqui localmente.
#
# Project Ref dev: aizoevovzuvrcvntpzft (financeiro-maxfem-dev em sa-east-1)
# Staging e prod a criar — quando vierem, geramos `.env.staging.local` etc

# --- Ambiente ---
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Em dev local, usamos localhost; em staging/prod, os subdomínios reais
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# --- Supabase DEV (anon é público; service role é privado) ---
NEXT_PUBLIC_SUPABASE_URL=https://aizoevovzuvrcvntpzft.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFpem9ldm92enV2cmN2bnRwemZ0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg5NDE3MjYsImV4cCI6MjA5NDUxNzcyNn0.wR8m-53e4yPTlGAOYPNyq47utkv36qn5sNDoFkvoONk

# Service Role: pega no Supabase Dashboard → Settings → API → service_role
# Salvar SOMENTE neste arquivo local + 1Password (vault "Financeiro Maxfem")
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=aizoevovzuvrcvntpzft
SUPABASE_DB_PASSWORD=

# --- Payment Provider ---
# dev/staging: mock (default). prod: inter (Sprint 5+).
PAYMENT_PROVIDER=mock

# --- Sentry (opcional em dev) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=financeiro@financeiromaxfem.com.br

# --- Integrações externas (todas em mock no MVP até Sprint 5+) ---
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_WEBHOOK_SECRET=
BTG_CLIENT_ID=
BTG_CLIENT_SECRET=
BTG_WEBHOOK_SECRET=
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
ANTHROPIC_API_KEY=

# --- Criptografia de dados bancários (pgcrypto) ---
# Gerar nova com: openssl rand -base64 48
# NUNCA reusar entre dev/staging/prod
BANK_ENCRYPTION_KEY=

# --- Limites de segurança ---
DAILY_AGGREGATE_LIMIT_BRL=100000
MAX_PAYMENT_AMOUNT_BRL=1000000
SESSION_TIMEOUT_ADMIN_MINUTES=480
SESSION_TIMEOUT_SUPPLIER_MINUTES=60
