{
  "name": "financeiro-maxfem",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema Financeiro Maxfem - gestão de contas a pagar/receber, conciliação assistida por IA, integração Inter/BTG/Bling, portal de fornecedor",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:rls": "vitest run tests/rls",
    "test:coverage": "vitest run --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db push",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --linked > src/types/supabase.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.50.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.8.0",
    "geist": "^1.7.0",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "uuid": "^14.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.6",
    "postcss": "^8.5.15",
    "supabase": "^2.107.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "ws": "^8.21.0"
  }
}
